<?xml version="1.0"?>
<!-- Sensores separados para que su integración sea fácil de leer y reutilizar. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="simple_diff_sensors" params="">
    <material name="sensor_red">
      <color rgba="0.85 0.15 0.15 1.0"/>
    </material>
    <material name="sensor_green">
      <color rgba="0.15 0.70 0.25 1.0"/>
    </material>

    <!-- LiDAR frontal: el plugin y los datos de rango se definen en Gazebo. -->
    <link name="laser_frame">
      <visual>
        <geometry><cylinder radius="0.035" length="0.025"/></geometry>
        <material name="sensor_red"/>
      </visual>
      <collision><geometry><cylinder radius="0.035" length="0.025"/></geometry></collision>
      <xacro:cylinder_inertial mass="0.03" radius="0.035"
        length="0.025" rpy="0 0 0"/>
    </link>
    <joint name="laser_joint" type="fixed">
      <parent link="base_link"/>
      <child link="laser_frame"/>
      <origin xyz="0.18 0 0.10" rpy="0 0 0"/>
    </joint>

    <!-- IMU: marco central que mide aceleración y orientación en simulación. -->
    <link name="imu_link">
      <visual>
        <geometry><box size="0.04 0.04 0.02"/></geometry>
        <material name="sensor_green"/>
      </visual>
      <collision><geometry><box size="0.04 0.04 0.02"/></geometry></collision>
      <xacro:box_inertial mass="0.02" x="0.04" y="0.04" z="0.02"/>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
    </joint>

    <!-- Cámara frontal: frame y carcasa; Gazebo publica la imagen. -->
    <link name="camera_link">
      <visual>
        <geometry><box size="0.05 0.05 0.035"/></geometry>
        <material name="sensor_green"/>
      </visual>
      <collision><geometry><box size="0.05 0.05 0.035"/></geometry></collision>
      <xacro:box_inertial mass="0.03" x="0.05" y="0.05" z="0.035"/>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent link="base_link"/>
      <child link="camera_link"/>
      <origin xyz="0.18 0 0.05" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
