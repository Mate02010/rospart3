<?xml version="1.0"?>
<!-- Mundo Gazebo pequeño y autocontenido para el robot diferencial. -->
<sdf version="1.10">
  <world name="default">
    <gravity>0 0 -9.81</gravity>

    <!-- Sistemas básicos de Gazebo: física, comandos, escena y sensores. -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
          <material>
            <diffuse>0.70 0.70 0.70 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="simple_diff_robot">
      <!-- La base queda sobre las ruedas, que tocan el suelo. -->
      <pose>0 0 0.13 0 0 0</pose>
      <self_collide>false</self_collide>

      <link name="base_link">
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.02</ixx><iyy>0.04</iyy><izz>0.05</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.45 0.30 0.12</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.45 0.30 0.12</size></box></geometry>
          <material><diffuse>0.10 0.35 0.80 1</diffuse></material>
        </visual>
      </link>

      <link name="left_wheel">
        <!-- El marco del link permanece alineado con el modelo para que el
             eje de la articulación 0 1 0 corresponda al eje transversal Y. -->
        <pose>0 0.17 -0.06 0 0 0</pose>
        <inertial>
          <mass>0.15</mass>
          <inertia>
            <ixx>0.0002</ixx><iyy>0.0001</iyy><izz>0.0002</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <!-- Los cilindros de SDF apuntan sobre Z; se rota solo la geometría
               para que la rueda quede orientada sobre Y. -->
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.04</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.04</length></cylinder></geometry>
          <material><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>

      <link name="right_wheel">
        <pose>0 -0.17 -0.06 0 0 0</pose>
        <inertial>
          <mass>0.15</mass>
          <inertia>
            <ixx>0.0002</ixx><iyy>0.0001</iyy><izz>0.0002</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.04</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.04</length></cylinder></geometry>
          <material><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>left_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        </axis>
      </joint>
      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>right_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        </axis>
      </joint>

      <!-- Rueda loca trasera. -->
      <link name="caster_link">
        <pose>-0.16 0 -0.10 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
          <material><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
      <joint name="caster_joint" type="fixed">
        <parent>base_link</parent>
        <child>caster_link</child>
      </joint>

      <!-- LiDAR frontal: publica en el tópico de Gazebo /scan. -->
      <link name="laser_link">
        <pose>0.18 0 0.10 0 0 0</pose>
        <sensor name="lidar" type="gpu_lidar">
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>/scan</topic>
          <ray>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.12</min>
              <max>8.0</max>
              <resolution>0.01</resolution>
            </range>
          </ray>
        </sensor>
        <visual name="visual">
          <geometry><cylinder><radius>0.04</radius><length>0.03</length></cylinder></geometry>
          <material><diffuse>0.85 0.20 0.20 1</diffuse></material>
        </visual>
      </link>
      <joint name="laser_joint" type="fixed">
        <parent>base_link</parent>
        <child>laser_link</child>
      </joint>

      <!-- IMU superior: publica aceleración y velocidad angular en /imu. -->
      <link name="imu_link">
        <pose>0 0 0.10 0 0 0</pose>
        <sensor name="imu" type="imu">
          <always_on>1</always_on>
          <update_rate>50</update_rate>
          <topic>/imu</topic>
        </sensor>
      </link>
      <joint name="imu_joint" type="fixed">
        <parent>base_link</parent>
        <child>imu_link</child>
      </joint>

      <!-- Cámara frontal: publica la imagen RGB en /camera/image. -->
      <link name="camera_link">
        <pose>0.18 0 0.05 0 0 0</pose>
        <sensor name="camera" type="camera">
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>/camera/image</topic>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>320</width>
              <height>240</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.1</near><far>20.0</far></clip>
          </camera>
        </sensor>
        <visual name="visual">
          <geometry><box><size>0.05 0.08 0.04</size></box></geometry>
          <material><diffuse>0.10 0.10 0.10 1</diffuse></material>
        </visual>
      </link>
      <joint name="camera_joint" type="fixed">
        <parent>base_link</parent>
        <child>camera_link</child>
      </joint>

      <!-- El controlador convierte /cmd_vel en giro de ruedas y publica /odom. -->
      <plugin filename="gz-sim-diff-drive-system"
              name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.34</wheel_separation>
        <wheel_radius>0.06</wheel_radius>
        <odom_publish_frequency>30</odom_publish_frequency>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
      </plugin>
    </model>
  </world>
</sdf>
