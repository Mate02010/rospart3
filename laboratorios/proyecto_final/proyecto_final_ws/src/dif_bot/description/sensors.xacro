<?xml version="1.0"?>
<!-- Sensores del robot: marco (link/joint) y sensor simulado de Gazebo. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="dif_bot_sensors" params="camara ruido_laser:=0.01">
    <material name="sensor_red"><color rgba="0.85 0.15 0.15 1.0"/></material>
    <material name="sensor_green"><color rgba="0.15 0.70 0.25 1.0"/></material>

    <!-- ===================== LiDAR 2D ===================== -->
    <link name="laser_frame">
      <visual>
        <geometry><cylinder radius="0.035" length="0.025"/></geometry>
        <material name="sensor_red"/>
      </visual>
      <collision><geometry><cylinder radius="0.035" length="0.025"/></geometry></collision>
      <xacro:cylinder_inertial mass="0.03" radius="0.035" length="0.025" rpy="0 0 0"/>
    </link>
    <joint name="laser_joint" type="fixed">
      <parent link="base_link"/>
      <child link="laser_frame"/>
      <origin xyz="0.18 0 0.10" rpy="0 0 0"/>
    </joint>

    <gazebo reference="laser_frame">
      <sensor name="lidar" type="gpu_lidar">
        <frame_id>laser_frame</frame_id>
        <topic>scan</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>${ruido_laser}</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>

    <!-- ===================== IMU ===================== -->
    <link name="imu_link">
      <visual>
        <geometry><box size="0.04 0.04 0.02"/></geometry>
        <material name="sensor_green"/>
      </visual>
      <collision><geometry><box size="0.04 0.04 0.02"/></geometry></collision>
      <xacro:box_inertial mass="0.02" x="0.04" y="0.04" z="0.02"/>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
    </joint>

    <gazebo reference="imu_link">
      <sensor name="imu" type="imu">
        <frame_id>imu_link</frame_id>
        <topic>imu</topic>
        <update_rate>100</update_rate>
        <always_on>1</always_on>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

    <!-- ===================== Cámara ===================== -->
    <link name="camera_link">
      <visual>
        <geometry><box size="0.05 0.05 0.035"/></geometry>
        <material name="sensor_green"/>
      </visual>
      <collision><geometry><box size="0.05 0.05 0.035"/></geometry></collision>
      <xacro:box_inertial mass="0.03" x="0.05" y="0.05" z="0.035"/>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent link="base_link"/>
      <child link="camera_link"/>
      <origin xyz="0.21 0 0.04" rpy="0 0 0"/>
    </joint>

    <!-- La cámara se simula solo con camara:=true (consume mucho en WSL). -->
    <xacro:if value="${camara}">
    <gazebo reference="camera_link">
      <sensor name="camera" type="camera">
        <frame_id>camera_link</frame_id>
        <topic>camera/image_raw</topic>
        <update_rate>5</update_rate>
        <always_on>1</always_on>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
    </xacro:if>
  </xacro:macro>

</robot>
