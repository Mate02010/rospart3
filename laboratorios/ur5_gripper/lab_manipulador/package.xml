<?xml version="1.0"?>
<package format="3">
  <name>lab_manipulador</name><version>1.0.0</version>
  <description>Rutina de manipulacion UR5 y pinza con ROS 2 y MoveIt.</description>
  <maintainer email="brayan@example.invalid">Brayan Mateo Bravo Losada</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend><exec_depend>std_srvs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend><exec_depend>control_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
